From ca99916c50ce4c9941ebdd9cea9ea5107c0cceae Mon Sep 17 00:00:00 2001
From: Paul Czarkowski <username.taken@gmail.com>
Date: Sun, 1 Nov 2026 05:16:49 +1000
Subject: [PATCH] keyboard: map the digit row, which was never translated

kPcToTowns left PC set-1 codes 0x02..0x0B (the digits 1..9,0) at zero, and
towns_key() returns false for a zero, so a number key was dropped before it
reached the queue. Ultima II's Generate Character -> Create asks for the entry
number as a digit, so the create prompt could not be answered at all.

The Towns JIS codes for the digit row are the same values as PC set-1
(TOWNSEMU townsdef.h: TOWNS_JISKEY_1 = 0x02 .. TOWNS_JISKEY_0 = 0x0B), so the
mapping is identity. Measured on the port: before, a pushed '4' left the queue
empty and the entry field unchanged; after, the field responds and character
creation reaches the attribute allocation screen.
---
 runtime/towns_sdl.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/runtime/towns_sdl.cpp b/runtime/towns_sdl.cpp
index 717c2d4..6df0aeb 100644
--- a/runtime/towns_sdl.cpp
+++ b/runtime/towns_sdl.cpp
@@ -101,8 +101,8 @@ static unsigned held_pad(SDL_Gamepad* g) {
 // from the wrong set indexes the wrong entry and the key reads as dead. On the port, space, return and up did nothing
 // while 'a' and down worked, and those are precisely the two the two sets happen to share.
 static const uint8_t kPcToTowns[128] = {
-    /* 0x00 */ 0,    0,    0,    0,    0,    0,    0,    0,
-    /* 0x08 */ 0,    0,    0,    0,    0x0C, 0x0D, 0x0F, 0x10,   // minus 0x0C, hat 0x0D, backspace 0x0F, tab 0x10
+    /* 0x00 */ 0,    0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,   // 1 2 3 4 5 6 7: same code on both sets
+    /* 0x08 */ 0x09, 0x0A, 0x0B, 0,    0x0C, 0x0D, 0x0F, 0x10,   // 8 9 0, minus 0x0C, hat 0x0D, backspace 0x0F, tab 0x10
     /* 0x10 */ 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18,   // Q W E R T Y U I
     /* 0x18 */ 0x19, 0x1A, 0x1C, 0x29, 0x1D, 0x52, 0x1E, 0x1F,   // O P [ ] return ctrl A S
     /* 0x20 */ 0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27,   // D F G H J K L ;
-- 
2.56.0

