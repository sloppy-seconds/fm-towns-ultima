# FM Towns emulator in a browser-accessible container.
#
# Runs Tsugaru under Xvfb, serves the display over VNC, and exposes VNC as a
# web page so it can be used from any browser. Built so U2 can be played and
# inspected from a remote machine.
#
#   build:  sudo podman build -t fmtowns -f container/Containerfile .
#   run:    ./tools/container-run.sh
#   browse: http://<host>:6080/vnc.html
#
# Everything the container needs that is copyrighted (ROMs) or large (the
# emulator) is bind-mounted at run time from vendor/, never baked in.

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV RESOLUTION=640x480x24

RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        libsdl2-2.0-0 \
        libsdl2-mixer-2.0-0 \
        libgtk-3-0 \
        libgl1 \
        libglu1-mesa \
        libasound2t64 \
        pulseaudio-utils \
        x11-utils \
        openbox \
        xdg-utils \
        xauth \
        xdotool \
        imagemagick \
        procps \
        ca-certificates \
        tini \
        nodejs \
        npm \
        python3 \
        python3-pil \
    && rm -rf /var/lib/apt/lists/*

# novnc ships its web root here on Ubuntu.
RUN test -d /usr/share/novnc && ln -sfn /usr/share/novnc /opt/novnc

COPY container/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY container/supervisor.js /usr/local/bin/supervisor.js
COPY container/screen.js /usr/local/bin/screen.js
COPY container/editor.html /usr/local/bin/editor.html
# The save editor shares one implementation with the CLI. Copying it into the
# image rather than duplicating the FAT and roster logic means the two cannot
# drift apart.
COPY tools/savedisk.js /usr/local/bin/savedisk.js

# The U2 driver scripts, so they can run INSIDE the container.
#
# WHY THIS IS NOT COPIED FOR CONVENIENCE. tools/u2flow.py drives the emulator with
# xdotool against DISPLAY=:99, and that display exists only inside the container:
# on the host /tmp/.X11-unix holds X0 and inside it holds X99. Running the script
# from the host therefore fails with
#
#     subprocess.CalledProcessError: ['/usr/bin/xdotool', 'mousemove', ...]
#
# and the failure looks like a bad icon coordinate rather than a missing display.
# Two hand-clicks at the wrong place were tried before the cause was found.
#
# They are placed together in /opt/u2 rather than copied one at a time because
# u2read.py and u2bot.py import PIL, and the set is used as a unit:
#
#     podman exec fmtowns python3 /opt/u2/u2flow.py --status
#     podman exec fmtowns python3 /opt/u2/u2flow.py --journey
#
# u2flow and u2screen are stdlib only. u2read and u2bot need python3-pil, which
# is installed explicitly above rather than left to arrive as a dependency of
# nodejs.
COPY tools/u2flow.py /opt/u2/u2flow.py
COPY tools/u2read.py /opt/u2/u2read.py
COPY tools/u2screen.py /opt/u2/u2screen.py
COPY tools/u2bot.py /opt/u2/u2bot.py
RUN chmod +x /usr/local/bin/entrypoint.sh

# Xvfb + VNC + noVNC. 6080 is the browser port, 5900 raw VNC.
EXPOSE 6080 5900 8080

# The emulator writes its CMOS and logs here. Mount a host dir over it.
VOLUME ["/data"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
